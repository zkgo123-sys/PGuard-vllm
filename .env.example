# ==== PGuard 服务配置（复制为 .env 后按需修改）====

# 主机侧 backbone 权重目录。
# 本机已有（推荐，14GB，vLLM 可直接加载，4090 原生支持 FP8）：
HOST_BACKBONE_DIR=/root/.cache/modelscope/hub/models/RedHatAI/Qwen3.5-9B-FP8-dynamic
# 若要 bf16 原版（PGuard 头训练时的精度，约 19GB，需另行下载）：
# modelscope download --model Qwen/Qwen3.5-9B --local_dir ./backbone/Qwen3.5-9B
# HOST_BACKBONE_DIR=./backbone/Qwen3.5-9B

# 服务暴露端口（宿主机）
PGUARD_PORT=13553

# 使用的 GPU（物理卡号）
PGUARD_GPU=5

# SGLang 方案的 PGuard 变体: stateless(Lasttok) | seq(EMA) | cfc(GRU)
PGUARD_VARIANT=seq

# vllm-guard 方案：风险判定阈值（非 normal 类最大概率）
PGUARD_THRESHOLD=0.5
# 安全头变体目录（pg_weight 下）：Lasttok / EMA / GRU
PGUARD_HEAD_SUBDIR=PGuard-Lasttok-Qwen3.5-9B
# 同时在线的头（逗号分隔；留空=仅用上面一个）。三头共享同一份主干与捕获特征
PGUARD_HEADS=

# 容器内显存占用比例
GPU_MEM_UTIL=0.90

# 最大上下文长度
MAX_MODEL_LEN=8192
